{
    "name": "open-dusa",
    "version": "1.2.0",
    "description": "Agentic AI Resident for Discord",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "start": "cross-env UV_THREADPOOL_SIZE=12 node index.js",
        "start:beefy": "cross-env UV_THREADPOOL_SIZE=16 NODE_OPTIONS=\"--max-old-space-size=3072 --max-semi-space-size=128\" node index.js",
        "start:max": "cross-env UV_THREADPOOL_SIZE=24 NODE_OPTIONS=\"--max-old-space-size=6144 --max-semi-space-size=256\" node index.js",
        "dev": "cross-env UV_THREADPOOL_SIZE=12 node --watch --expose-gc index.js",
        "format": "prettier --write \"**/*.{js,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,json,md}\""
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "overrides": {
        "better-sqlite3": {
            "peer": true
        }
    },
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "@tavily/core": "^0.5.3",
        "better-sqlite3": "^12.0.0",
        "better-sqlite3-multiple-ciphers": "^12.0.0",
        "cross-env": "^7.0.3",
        "discord.js": "^14.27.0",
        "libsodium-wrappers": "^0.8.4",
        "lru-cache": "^11.2.7",
        "openai": "^6.34.0",
        "undici": "^6.24.1"
    },
    "devDependencies": {
        "prettier": "^3.3.3"
    },
    "allowScripts": {
        "better-sqlite3@12.11.1": true,
        "better-sqlite3-multiple-ciphers@12.11.1": true
    }
}
