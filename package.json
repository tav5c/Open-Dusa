{
    "name": "open-dusa",
    "version": "1.1.0",
    "description": "Agentic AI Resident for Discord",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "start": "cross-env UV_THREADPOOL_SIZE=12 node index.js",
        "dev": "cross-env UV_THREADPOOL_SIZE=12 node --watch --expose-gc index.js",
        "lint": "eslint \"**/*.js\"",
        "lint:fix": "eslint \"**/*.js\" --fix",
        "format": "prettier --write \"**/*.{js,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,json,md}\"",
        "db:compact": "node -e \"const Database = require('better-sqlite3'); ['Logs/medusa.db', ...require('fs').readdirSync('Ai Database', {recursive:true}).filter(f=>f.endsWith('.db')).map(f=>'Ai Database/'+f)].forEach(p=>{try{const d=new Database(p);d.prepare('VACUUM').run();d.close();console.log('VACUUM',p)}catch(e){console.log('SKIP',p,e.message)}})\""
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "overrides": {
        "better-sqlite3": {
            "peer": true
        }
    },
    "dependencies": {
        "@discordjs/voice": "^0.17.0",
        "@tavily/core": "^0.5.3",
        "better-sqlite3": "^12.0.0",
        "cross-env": "^7.0.3",
        "discord.js": "^14.26.3",
        "libsodium-wrappers": "^0.7.16",
        "lru-cache": "^11.2.7",
        "openai": "^6.34.0",
        "systeminformation": "^5.31.5",
        "undici": "^6.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "eslint": "^9.15.0",
        "globals": "^15.12.0",
        "prettier": "^3.3.3"
    }
}
